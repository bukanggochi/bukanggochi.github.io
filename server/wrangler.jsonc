{
  // 상어집사 API 서버 (Cloudflare Workers)
  // Cloudflare 대시보드의 Worker 이름과 반드시 같아야 한다 (Workers Builds 연동).
  "name": "shark-keeper-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shark-keeper",
      "database_id": "05d64fc1-f16c-419e-93c5-dccc8efeed5a"
    }
  ],
  // 1시간마다(매시 7분) 오래 접속하지 않은 상어를 정산해 랭킹·사망을 반영한다
  "triggers": { "crons": ["7 * * * *"] }
  // 테이블은 src/schema.js가 첫 요청 때 자동으로 만든다
}
